{
  "name": "esevai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "db:create": "tsx src/db/create-database.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "test": "vitest run",
    "db:seed-admin": "tsx src/db/seed-master-admin.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.12",
    "@pdf-lib/fontkit": "^1.1.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.13.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mssql": "^12.7.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
