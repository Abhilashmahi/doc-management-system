# Copy this file to backend/.env and fill in your real values. backend/.env is never committed to Git.

PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Local SQL Server Express instance (named instance = HOST\INSTANCE)
DB_SERVER=ABHILASH\SQLEXPRESS
# Optional: connect to this port directly when the SQL Server Browser service is not running.
# DB_PORT=1433
DB_NAME=ESevaiDocumentManager
DB_USER=sa
DB_PASSWORD=REPLACE_WITH_MY_LOCAL_PASSWORD
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_TTL_HOURS=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Used only by "npm run db:seed-admin" to create the first Master Admin
# Optional sign-in name. If this line is left out, the admin signs in with ADMIN_EMAIL.
# ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_12_CHARS_MIN
ADMIN_NAME=Master Administrator

# Google sign-in (optional). The "Continue with Google" button appears only when both values are set.
# README.md, section "Google sign-in setup", explains where to get them.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# FRONTEND_URL=http://localhost:5173

# Folder for uploaded files (relative to the backend folder). Back it up together with the database.
STORAGE_DIR=storage

# Optional: full path to LibreOffice's soffice.exe, if it is not in the usual Program Files folder.
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Sharing (optional).
# Address other people use to open the app. Share links start with it. Defaults to FRONTEND_URL.
# PUBLIC_URL=https://docs.your-esevai-centre.in
# Send documents by e-mail with the file attached. For Gmail: turn on 2-Step Verification for the Google account,
# create an App Password at https://myaccount.google.com/apppasswords, and put it here (not the normal password).
# SMTP_USER=yourcentre@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM_NAME=Arun e-Sevai Maiyam
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
